# ==============================================================================
# Tệp mẫu cấu hình môi trường (.env) - Shoes Store Nhóm 6
# Hướng dẫn: Sao chép tệp này thành .env trên máy của bạn và điền giá trị phù hợp.
# TUYỆT ĐỐI KHÔNG commit tệp .env chứa khóa thật lên Git repository.
# ==============================================================================

# 1. Khóa bí mật phiên làm việc (BẮT BUỘC TRÊN PRODUCTION):
# Tạo khóa ngẫu nhiên an toàn bằng lệnh:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-secret-key-min-32-chars

# 2. Môi trường chạy (development / testing / production)
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# 3. Chọn hệ quản trị cơ sở dữ liệu (sqlite hoặc sqlserver):
DB_BACKEND=sqlite

# Đường dẫn database SQLite (để trống để dùng mặc định instance/demo.sqlite3):
DB_PATH=

# Cấu hình chuỗi kết nối Microsoft SQL Server (khi DB_BACKEND=sqlserver):
# SQLSERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=QuanLyBanHang;Trusted_Connection=yes;TrustServerCertificate=yes;
